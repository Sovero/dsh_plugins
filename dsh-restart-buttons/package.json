{
  "name": "dsh-restart-buttons",
  "version": "1.0.0",
  "type": "module",
  "description": "Две кнопки в подвале боковой панели DSH: перезагрузка интерфейса и полный перезапуск DSH Desktop на Windows / Two sidebar-foot buttons for DSH: reload the interface, or fully relaunch DSH Desktop on Windows.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-restart",
    "restart",
    "reload",
    "sidebar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovero/dsh_plugins.git",
    "directory": "dsh-restart-buttons"
  },
  "homepage": "https://github.com/Sovero/dsh_plugins/tree/main/dsh-restart-buttons",
  "bugs": {
    "url": "https://github.com/Sovero/dsh_plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
