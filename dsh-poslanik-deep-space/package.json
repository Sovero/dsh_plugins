{
  "name": "dsh-poslanik-deep-space",
  "version": "1.5.0",
  "type": "module",
  "description": "Тема «Глубокий космос» для DSH / Deep space theme for DSH: stars, dwarfs, suns, black holes, ships with trails and course changes, meteors, comets and planets under the interface text; pointer movement applies an electromagnetic perturbation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deep-space",
    "poslanik"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovero/dsh_plugins.git",
    "directory": "dsh-poslanik-deep-space"
  },
  "homepage": "https://github.com/Sovero/dsh_plugins/tree/main/dsh-poslanik-deep-space",
  "bugs": {
    "url": "https://github.com/Sovero/dsh_plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:installed": "node scripts/check-installed.mjs",
    "test": "node --experimental-test-isolation=none --test tests/theme.test.mjs",
    "version:set": "node scripts/version-set.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
